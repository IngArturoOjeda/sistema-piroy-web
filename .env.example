# --- SQL Server local (usado por sincronizador/ y, por ahora, por backend items/promos) ---
DB_DRIVER=ODBC Driver 18 for SQL Server
DB_SERVER=localhost
DB_NAME=nombre_base_datos
DB_USER=usuario_sql
DB_PASSWORD=contraseña_sql

# --- PostgreSQL (usado por backend/app, en Render) ---
DATABASE_URL=postgresql://usuario:contraseña@servidor:5432/base_datos

# --- Autenticación privada del sincronizador (header X-API-Key) ---
SYNC_API_KEY=clave_larga_aleatoria_ficticia